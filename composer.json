{
    "name": "bahdan/symfony-safe-http-client",
    "description": "SSRF-protected HTTP Client wrapper for Symfony HttpClient with DNS resolution pinning and subnet validation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bahdan",
            "homepage": "https://bahdanhal.pl"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/http-client": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bahdan\\SafeHttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bahdan\\SafeHttpClient\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
